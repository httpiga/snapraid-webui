{
  "name": "snapraid-webui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "pnpm --filter @snapraid-webui/backend dev",
    "dev:frontend": "pnpm --filter @snapraid-webui/frontend dev",
    "build": "pnpm run build:frontend && pnpm run build:backend",
    "build:backend": "pnpm --filter @snapraid-webui/backend build",
    "build:frontend": "pnpm --filter @snapraid-webui/frontend build",
    "start": "pnpm --filter @snapraid-webui/backend start",
    "lint": "pnpm --filter @snapraid-webui/frontend lint",
    "typecheck": "pnpm --filter @snapraid-webui/backend typecheck && pnpm --filter @snapraid-webui/frontend typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.3"
  }
}
